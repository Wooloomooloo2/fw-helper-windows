<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>FwHelper</RootNamespace>
    <AssemblyName>FwHelper</AssemblyName>
    <Version>0.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>FW-Helper</Product>
    <Description>Lightweight control tool for the Framework Laptop 13</Description>
    <DebugType>embedded</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Run on any newer installed .NET desktop runtime (e.g. .NET 10) -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

  <!-- TraceEvent copies kernel-session and symbol-lookup support files (amd64\KernelTraceControl.dll, msdia140.dll,
       TraceReloggerLib.dll, Dia2Lib.dll). FPS capture uses a user-mode session only and was verified without them
       (ADR 0017), so keep the publish a single exe. -->
  <Target Name="DropTraceEventSupportFiles" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.FullPath)').ToLowerInvariant().Contains('microsoft.diagnostics.tracing.traceevent'))" />
    </ItemGroup>
  </Target>


</Project>
